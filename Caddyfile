{
	servers {
		# Chiude i client lenti (slowloris) prima che occupino connessioni.
		timeouts {
			read_header 10s
			read_body 10s
		}
	}
}

(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		defer
	}
	header /api >Cache-Control "no-store"
	header /api/* >Cache-Control "no-store"
}

{$DOMAIN:localhost} {
	import security_headers
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
	request_body {
		max_size 10KiB
	}
	encode gzip
	reverse_proxy app:3000 {
		transport http {
			# Meno dei 5 s di keep-alive di uvicorn: non riusa connessioni già chiuse (502 sui POST).
			keepalive 4s
		}
	}
}
