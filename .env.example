# Copia in .env e personalizza
DOMAIN=example.com
ADMIN_PASSWORD=cambiami
SESSION_SECRET=genera-con-openssl-rand-hex-32

# Mail di conferma (senza SMTP_HOST le mail vengono solo scritte nel log)
PUBLIC_URL=https://example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=prenotazioni@example.com
# Fuso orario dei turni
APP_TZ=Europe/Rome
